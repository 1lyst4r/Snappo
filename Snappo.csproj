<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.1</Version>
    <!-- Other copies of the source (git clone, old QuickSnap project) and installer output live in subfolders; never compile them. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Snappo\**;QuickSnap\**;installer\**</DefaultItemExcludes>
    <!-- Keep idle memory and background threads low. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Tells the GC to aggressively trim the working set back to the OS instead of holding onto free heap space. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
  </ItemGroup>

  <!--
    Release builds are a single small Snappo.exe that uses the shared .NET 8 Desktop Runtime
    (the installer installs the runtime if it's missing). Pre-compiled (ReadyToRun) so it starts fast.
    Just run:  dotnet publish -c Release
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
